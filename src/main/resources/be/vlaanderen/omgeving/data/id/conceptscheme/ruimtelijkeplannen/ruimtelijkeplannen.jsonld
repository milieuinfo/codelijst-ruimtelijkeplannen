    "graph": [
        {
            "id": "procedurekenmerken:bevat-planologische-compensatie",
            "_type": [
                "skos:Concept"
            ],
            "altLabel": "Bevat planologische compensatie",
            "definition": "Deze procedure genereert een positieve balans.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "BEVAT_PLANOLOGISCHE_COMPENSATIE",
            "note": "Deze procedure genereert een positieve balans.",
            "prefLabel": "Het plan bevat compensatie",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:delegatie",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Via een delegatie draagt een plannende overheid de bevoegdheid om een planproces te voeren over aan een andere (hogere of lagere) plannende overheid.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "DELEGATIE",
            "note": "Via een delegatie draagt een plannende overheid de bevoegdheid om een planproces te voeren over aan een andere (hogere of lagere) plannende overheid.",
            "prefLabel": "Delegatie",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:gebruikersschade",
            "_type": [
                "skos:Concept"
            ],
            "definition": "De schade die een landbouwer lijdt wanneer de landbouwgrond aan gebruiksbeperkingen moet voldoen.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "GEBRUIKERSSCHADE",
            "note": [
                "De schade die een landbouwer lijdt wanneer de landbouwgrond aan gebruiksbeperkingen moet voldoen.",
                "Bijvoorbeeld een bestemmingswijziging (van landbouw naar natuur of bos), het opleggen van een erfdienstbaarheid of een overdruk in een ruimtelijk plan."
            ],
            "prefLabel": "Gebruikersschade",
            "scopeNote": "Bijvoorbeeld een bestemmingswijziging (van landbouw naar natuur of bos), het opleggen van een erfdienstbaarheid of een overdruk in een ruimtelijk plan.",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:grensoverschrijdende-effecten",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Mogelijke effecten in grensgemeenten waarvoor grensoverschrijdende instanties geraadpleegd moeten worden en/of in het planproces betrokken worden.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "GRENSOVERSCHRIJDENDE_EFFECTEN",
            "note": "Mogelijke effecten in grensgemeenten waarvoor grensoverschrijdende instanties geraadpleegd moeten worden en/of in het planproces betrokken worden.",
            "prefLabel": "Grensoverschrijdende effecten",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:herneming",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Wanneer een RvS-procedure een plan geheel of gedeeltelijk vernietigt, kan de initiatiefnemer beslissen om het plan geheel of gedeeltelijk te hernemen.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "HERNEMING",
            "note": "Wanneer een RvS-procedure een plan geheel of gedeeltelijk vernietigt, kan de initiatiefnemer beslissen om het plan geheel of gedeeltelijk te hernemen.",
            "prefLabel": "Herneming",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:kapitaalschade",
            "_type": [
                "skos:Concept"
            ],
            "definition": "De schade die de eigenaar van landbouwgrond lijdt doordat de overheid de economische mogelijkheden van die grond beperkt.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "KAPITAALSCHADE",
            "note": "De schade die de eigenaar van landbouwgrond lijdt doordat de overheid de economische mogelijkheden van die grond beperkt.",
            "prefLabel": "Kapitaalschade",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:onteigening",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Instrument om het gebruik van gronden te regelen.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "ONTEIGENING",
            "note": [
                "Instrument om het gebruik van gronden te regelen.",
                "De noodzaak en proportionaliteit van de onteigening moeten goed gemotiveerd worden, inclusief bewijs dat alternatieven niet haalbaar zijn."
            ],
            "prefLabel": "Onteigening",
            "scopeNote": "De noodzaak en proportionaliteit van de onteigening moeten goed gemotiveerd worden, inclusief bewijs dat alternatieven niet haalbaar zijn.",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:overeenkomst",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Een overeenkomst wordt gemaakt met minstens één andere partij en wordt ten laatste in de fase voorlopige vaststelling opgenomen en mee ter inzage gelegd tijdens het openbaar onderzoek.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "OVEREENKOMST",
            "note": "Een overeenkomst wordt gemaakt met minstens één andere partij en wordt ten laatste in de fase voorlopige vaststelling opgenomen en mee ter inzage gelegd tijdens het openbaar onderzoek.",
            "prefLabel": "Overeenkomst",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:passende-beoordeling",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Een ecologisch onderzoeksrapport dat nagaat of een gepland project negatieve gevolgen heeft voor de natuurlijke kenmerken en instandhoudingsdoelstellingen van een Europees beschermd Natura 2000-gebied.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "PASSENDE_BEOORDELING",
            "note": "Een ecologisch onderzoeksrapport dat nagaat of een gepland project negatieve gevolgen heeft voor de natuurlijke kenmerken en instandhoudingsdoelstellingen van een Europees beschermd Natura 2000-gebied.",
            "prefLabel": "Passende beoordeling",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:planbaten",
            "_type": [
                "skos:Concept"
            ],
            "definition": "Een waardestijging (meerwaarde) van een perceel grond die ontstaat doordat de overheid de bestemming van dat perceel wijzigt.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "PLANBATEN",
            "note": "Een waardestijging (meerwaarde) van een perceel grond die ontstaat doordat de overheid de bestemming van dat perceel wijzigt.",
            "prefLabel": "Planbaten",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
        {
            "id": "procedurekenmerken:planschade",
            "_type": [
                "skos:Concept"
            ],
            "definition": "De financiële schade of waardevermindering die een eigenaar lijdt doordat de overheid een bestemmingsplan of ruimtelijk plan wijzigt.",
            "inScheme": "conceptscheme:ruimtelijkeplannen/procedurekenmerken",
            "code": "PLANSCHADE",
            "note": "De financiële schade of waardevermindering die een eigenaar lijdt doordat de overheid een bestemmingsplan of ruimtelijk plan wijzigt.",
            "prefLabel": "Planschade",
            "topConceptOf": "conceptscheme:ruimtelijkeplannen/procedurekenmerken"
        },
